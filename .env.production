# .env.production
# Renombra este archivo a ".env" en tu servidor de Oracle Cloud.

# Supabase PostgreSQL
DB_HOST=aws-0-us-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxx
DB_PASSWORD=tu_contraseña_de_supabase_aqui

# URL de tu servidor en Oracle Cloud (cambia la IP_AQUI por tu IP Pública de la máquina Oracle)
SERVER_URL=http://IP_AQUI/metrics
